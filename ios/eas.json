{
  "cli": {
    "version": ">= 18.0.5",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_ENV": "staging" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_ENV": "staging" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_ENV": "production" }
    }
  },
  "submit": {
    "production": {}
  }
}
