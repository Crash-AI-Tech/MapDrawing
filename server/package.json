{
  "name": "@mapdrawing/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api/*": "./src/api/*.ts",
    "./actions/*": "./src/actions/*.ts",
    "./auth/*": "./src/auth/*.ts",
    "./db/*": "./src/db/*.ts",
    "./drawings/*": "./src/drawings/*.ts",
    "./email/*": "./src/email/*.ts",
    "./http/*": "./src/http/*.ts",
    "./ink": "./src/ink.ts",
    "./product-metrics": "./src/product-metrics.ts",
    "./storage/*": "./src/storage/*.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "db:check": "sh scripts/check-migrations.sh",
    "db:migrate:local": "wrangler d1 migrations apply map-db-v2 --local --config cloudflare/wrangler.toml"
  },
  "dependencies": {
    "@lucia-auth/adapter-sqlite": "^3.0.2",
    "@mapdrawing/contracts": "workspace:^",
    "@opennextjs/cloudflare": "^1.16.3",
    "drizzle-orm": "^0.38.0",
    "jose": "^6.1.3",
    "lucia": "^3.2.0",
    "next": "^16.1.6",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.63.0"
  }
}
