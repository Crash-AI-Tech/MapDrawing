# Auth (在 .dev.vars 中设置 secrets)
AUTH_SECRET="your-32-char-random-string"
RESEND_API_KEY=""
APPLE_CLIENT_ID="com.niubi.agent"
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# MapLibre (可选)
NEXT_PUBLIC_MAPLIBRE_STYLE_URL="https://tiles.example.com/style.json"

# Search engine ownership verification (optional; values come from each webmaster console)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# 注意: D1/R2/KV 通过 wrangler.toml 配置，无需环境变量
