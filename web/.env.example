# Web browser configuration. Server secrets belong in
# server/cloudflare/.dev.vars and must never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_MAPLIBRE_STYLE_URL="https://tiles.example.com/style.json"

# Search engine ownership verification (optional; values come from each webmaster console)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""
