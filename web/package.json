{
  "name": "web",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "cloudflare:build": "opennextjs-cloudflare build --config ../server/cloudflare/wrangler.toml --openNextConfigPath ../server/cloudflare/open-next.config.ts",
    "preview": "pnpm cloudflare:build && opennextjs-cloudflare preview --config ../server/cloudflare/wrangler.toml",
    "lint": "eslint .",
    "type-check": "next typegen && tsc --noEmit",
    "deploy:production": "node ../server/scripts/assert-production-target.mjs ../server/cloudflare/wrangler.toml && pnpm cloudflare:build && opennextjs-cloudflare deploy --config ../server/cloudflare/wrangler.toml",
    "upload": "node ../server/scripts/assert-production-target.mjs ../server/cloudflare/wrangler.toml && pnpm cloudflare:build && opennextjs-cloudflare upload --config ../server/cloudflare/wrangler.toml"
  },
  "dependencies": {
    "@mapdrawing/contracts": "workspace:^",
    "@mapdrawing/server": "workspace:^",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^4.7.0",
    "next": "^16.1.6",
    "rbush": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "uuid": "^11.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@eslint/eslintrc": "^3.0.0",
    "@opennextjs/cloudflare": "^1.16.3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.63.0"
  }
}
