{
    "name": "niubiagent-monorepo",
    "private": true,
    "scripts": {
        "dev": "pnpm --filter web dev",
        "build": "pnpm --filter web build",
        "deploy": "pnpm --filter web deploy",
        "type-check": "pnpm --filter @niubi/shared type-check && pnpm --filter web type-check && pnpm --filter ios type-check",
        "lint": "pnpm --filter web lint && pnpm --filter ios lint",
        "db:check": "sh scripts/check-migrations.sh",
        "db:migrate:v2": "node scripts/migrate-d1-v2.mjs",
        "test": "pnpm --filter @niubi/shared test",
        "check": "pnpm db:check && pnpm test && pnpm type-check && pnpm lint"
    },
    "packageManager": "pnpm@9.0.0",
    "engines": {
        "node": ">=20.9 <25"
    },
    "dependencies": {
        "drizzle-orm": "^0.38.0"
    },
    "devDependencies": {
        "drizzle-kit": "^0.30.0"
    }
}
